# 5-hour deadline overrides — source via run_experiments_5hour.sh
export FAST_MODE=1
export EXP_WANDB_GROUP="${EXP_WANDB_GROUP:-deadline-5h}"

# Match existing completed pranav runs (roberta-base, 1 seed)
export EXP_PRESET="${EXP_PRESET:-roberta-base}"
export EXP_RESTARTS="${EXP_RESTARTS:-1}"
export EXP_GPUS="${GPUS:-0,1,2,3,4}"
export EXP_EPOCHS_WINO="${EXP_EPOCHS_WINO:-5}"
export EXP_EPOCHS_SNLI="${EXP_EPOCHS_SNLI:-3}"
export EXP_EPOCHS_MNLI="${EXP_EPOCHS_MNLI:-3}"
export EXP_EPOCHS_QNLI="${EXP_EPOCHS_QNLI:-3}"
export EXP_BATCH_SIZE_WINO="${EXP_BATCH_SIZE_WINO:-64}"
export EXP_BATCH_SIZE_NLI="${EXP_BATCH_SIZE_NLI:-96}"

# Subsampled maps only (never full SNLI/MNLI)
export EXP_MAX_TRAIN_SAMPLES="${EXP_MAX_TRAIN_SAMPLES:-8000}"
export EXP_MAX_EVAL_SAMPLES="${EXP_MAX_EVAL_SAMPLES:-1500}"

export EXP_INPUT="${EXP_INPUT:-results/20260609_074628_snli_winogrande_roberta-large/fixed-maps/adaptive/20260609_074628_cartography_with_regions.jsonl}"

# Reuse existing output dirs where training already finished
export TABLE2_OUTPUT="${TABLE2_OUTPUT:-data/processed/region_finetune_winogrande}"
export FIG3_OUTPUT="${FIG3_OUTPUT:-data/processed/easy_role}"
export FIG4_OUTPUT="${FIG4_OUTPUT:-data/processed/noise_detection_paper}"
export SNLI_MAP_RUN="${SNLI_MAP_RUN:-results/20260527_051157_snli_mnli_roberta-base}"
export SKIP_TRAIN_TABLE2="${SKIP_TRAIN_TABLE2:-1}"
export SKIP_TRAIN_FIG3="${SKIP_TRAIN_FIG3:-1}"
export SKIP_TRAIN_FIG4="${SKIP_TRAIN_FIG4:-1}"
export SKIP_EXP_02="${SKIP_EXP_02:-1}"
export SKIP_EXP_08="${SKIP_EXP_08:-1}"
export SKIP_EXP_09="${SKIP_EXP_09:-1}"
export SKIP_EXP_10="${SKIP_EXP_10:-1}"
export SKIP_EXP_01="${SKIP_EXP_01:-1}"
