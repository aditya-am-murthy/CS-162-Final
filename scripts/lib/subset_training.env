# Subsampled training for exp 01, 02, 08, 09 (~2-3 h total on 5x RTX 3090).
export SUBSET_MODE=1
export EXP_NO_TMUX=0
export EXP_WANDB_GROUP="${EXP_WANDB_GROUP:-subset-final-four}"

export EXP_PRESET="${EXP_PRESET:-roberta-base}"
export EXP_RESTARTS="${EXP_RESTARTS:-1}"
export EXP_GPUS="${EXP_GPUS:-0,1,2,3,4}"

# Multi-GPU layout (5x RTX 3090)
export GPU_SNLI_MAP="${GPU_SNLI_MAP:-0}"
export GPU_MNLI_MAP="${GPU_MNLI_MAP:-1}"
export GPU_QNLI_MAP="${GPU_QNLI_MAP:-2}"
export GPUS_TABLE3_SNLI="${GPUS_TABLE3_SNLI:-0,1}"
export GPUS_TABLE3_MNLI="${GPUS_TABLE3_MNLI:-2,3}"
export GPUS_TABLE4_QNLI="${GPUS_TABLE4_QNLI:-4}"

# Map collection: 10k train / 2k eval / 3 epochs ≈ 30-45 min per dataset
export EXP_MAX_TRAIN_SAMPLES="${EXP_MAX_TRAIN_SAMPLES:-10000}"
export EXP_MAX_EVAL_SAMPLES="${EXP_MAX_EVAL_SAMPLES:-1500}"
export EXP_EPOCHS_SNLI="${EXP_EPOCHS_SNLI:-3}"
export EXP_EPOCHS_MNLI="${EXP_EPOCHS_MNLI:-3}"
export EXP_EPOCHS_QNLI="${EXP_EPOCHS_QNLI:-3}"
export EXP_BATCH_SIZE_NLI="${EXP_BATCH_SIZE_NLI:-96}"

# Region-finetune (Tables 3/4): train on 33% subsets from subsampled maps
export TABLE3_STRATEGIES="${TABLE3_STRATEGIES:-high_variability low_confidence random full}"
export TABLE4_STRATEGIES="${TABLE4_STRATEGIES:-high_variability low_confidence random full}"

export SKIP_EXP_01="${SKIP_EXP_01:-0}"
export SKIP_EXP_02="${SKIP_EXP_02:-0}"
export SKIP_EXP_08="${SKIP_EXP_08:-0}"
export SKIP_EXP_09="${SKIP_EXP_09:-0}"
